{
  "name": "bharat-sangeet-club",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "report:bundle": "node scripts/bundle-report.mjs",
    "start": "next start",
    "test": "npm run test:unit && npm run test:component",
    "test:component": "vitest run",
    "test:db": "scripts/db-replay.sh",
    "test:contract": "scripts/contract-check/run.sh",
    "test:contract:selftest": "scripts/contract-check/run.sh --selftest",
    "test:types-drift": "scripts/contract-check/run.sh --types-drift",
    "test:types-drift:selftest": "scripts/contract-check/run.sh --types-drift --selftest",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "db:generate": "drizzle-kit generate",
    "test:unit": "node --test tests/archive-sharing.test.mjs tests/attendance-model.test.mjs tests/bootstrap.test.mjs tests/bounded-wait.test.mjs tests/dates.test.mjs tests/errors.test.mjs tests/finance-summary.test.mjs tests/format.test.mjs tests/load-state.test.mjs tests/public-concerts.test.mjs tests/resources-query.test.mjs tests/sections.test.mjs tests/single-flight.test.mjs tests/storage-remove.test.mjs tests/toast.test.mjs",
    "test:browser": "NODE_USE_ENV_PROXY=1 playwright test -c tests/browser/playwright.config.mjs",
    "test:browser:update": "E2E_SHOTS=update NODE_USE_ENV_PROXY=1 playwright test -c tests/browser/playwright.config.mjs",
    "test:browser:compare": "node tests/browser/tools/compare-screenshots.mjs",
    "test:browser:timings": "E2E_SUITE=timings NODE_USE_ENV_PROXY=1 playwright test -c tests/browser/playwright.config.mjs && node tests/browser/tools/timings-report.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource/barlow-condensed": "^5.2.6",
    "@supabase/supabase-js": "^2.112.2",
    "drizzle-orm": "0.45.2",
    "framer-motion": "^13.1.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-dropzone": "^20.1.1",
    "tone": "^15.1.22",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "31.0.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vitest": "5.1.2",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
