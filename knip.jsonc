{
  // Dead code check: `npm run knip`, a failing step of the CI job `app`. A finding is deleted, or explained in this file.
  // Entry files are found by knip's plugins (Next app router, Vitest, node --test files named in package.json scripts, the
  // Playwright config below); what is listed here is what no plugin knows about.
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    // Started from a command line (package.json scripts, CI, scripts/*.sh), imported by nothing.
    "scripts/**/*.mjs",
    "tests/browser/tools/*.mjs"
  ],
  "playwright": {
    // The browser suite is not in the root: its config and its specs are named here.
    "config": ["tests/browser/playwright.config.mjs"],
    "entry": ["tests/browser/specs/*.spec.mjs"]
  },
  "ignore": [
    // Generated by `supabase gen types`, never edited by hand (lib/db.ts takes what it needs): its unused exports are the generator's.
    "lib/database.types.ts",
    // TEMPORARY: the Cloudflare/vinext/Drizzle starter, removed in the last commit of this branch (its commit also removes these lines).
    "app/chatgpt-auth.ts", "db/**", "examples/**", "worker/**"
  ],
  "ignoreDependencies": [
    // TEMPORARY, with the starter (only db/ imports it).
    "drizzle-orm"
  ],
  "ignoreBinaries": [
    // The PostgreSQL client of the throwaway database the contract check starts (apt postgresql-16), not an npm package.
    "psql"
  ]
}
