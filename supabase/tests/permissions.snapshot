    using: ((bucket_id = 'club-resources'::text) AND (EXISTS ( SELECT 1 FROM resources resource WHERE ((resource.storage_bucket = objects.bucket_id) AND (resource.storage_path = objects.name) AND (( SELECT private.is_executive() AS is_executive) OR ((resource.status = ANY (ARRAY['pending_upload'::resource_status, 'failed'::resource_status])) AND private.can_manage_resource(resource.subgroup_id, resource.visibility)))))))
