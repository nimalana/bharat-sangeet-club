    check: -
storage.objects  [Members delete their recording notation]  DELETE  to authenticated
    using: ((bucket_id = 'recording-notations'::text) AND ((EXISTS ( SELECT 1 FROM recording_notes note WHERE ((note.storage_path = objects.name) AND (( SELECT private.is_executive() AS is_executive) OR (note.uploaded_by = ( SELECT auth.uid() AS uid)) OR (EXISTS ( SELECT 1 FROM recordings recording WHERE ((recording.id = note.recording_id) AND (recording.uploaded_by = ( SELECT auth.uid() AS uid))))))))) OR (((storage.foldername(name))[1] = (( SELECT auth.uid() AS uid))::text) AND (NOT (EXISTS ( SELECT 1 FROM recording_notes note WHERE (note.storage_path = objects.name)))))))
    check: -
