    using: ( SELECT private.is_executive() AS is_executive)
    check: ( SELECT private.is_executive() AS is_executive)
public.archive_items  [Members view permitted archive]  SELECT  to authenticated
    using: (( SELECT private.is_executive() AS is_executive) OR ((subgroup_id IS NULL) AND (visibility = 'members'::archive_visibility)) OR ((subgroup_id IS NOT NULL) AND (EXISTS ( SELECT 1 FROM subgroup_memberships membership WHERE ((membership.subgroup_id = archive_items.subgroup_id) AND (membership.member_id = ( SELECT auth.uid() AS uid)) AND (membership.status = 'active'::subgroup_membership_status))))))
    check: -
public.archive_items  [Visitors view public concert recordings]  SELECT  to anon
    using: (is_public AND (type = 'recording'::archive_type))
    check: -
