storage.objects  [Delete resource files: executives, or unfinished uploads]  DELETE  to authenticated
    using: ((bucket_id = 'club-resources'::text) AND (EXISTS ( SELECT 1 FROM resources resource WHERE ((resource.storage_bucket = objects.bucket_id) AND (resource.storage_path = objects.name) AND (( SELECT private.is_executive() AS is_executive) OR ((resource.status = ANY (ARRAY['pending_upload'::resource_status, 'failed'::resource_status])) AND private.can_manage_resource(resource.subgroup_id, resource.visibility)))))))
    check: -
storage.objects  [Executives delete archive files]  DELETE  to authenticated
    using: ((bucket_id = 'club-archive'::text) AND ( SELECT private.is_executive() AS is_executive))
    check: -
storage.objects  [Executives delete finance files]  DELETE  to authenticated
    using: ((bucket_id = 'finance-private'::text) AND ( SELECT private.is_executive() AS is_executive) AND (NOT private.finance_path_registered(name)))
    check: -
storage.objects  [Executives read finance files]  SELECT  to authenticated
