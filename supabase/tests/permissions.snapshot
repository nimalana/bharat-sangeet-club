public.recordings  [Members create subgroup recordings]  INSERT  to authenticated
    using: -
    check: ((uploaded_by = ( SELECT auth.uid() AS uid)) AND (subgroup_id IS NOT NULL) AND (( SELECT private.is_executive() AS is_executive) OR (EXISTS ( SELECT 1 FROM subgroup_memberships membership WHERE ((membership.subgroup_id = recordings.subgroup_id) AND (membership.member_id = ( SELECT auth.uid() AS uid)) AND (membership.status = 'active'::subgroup_membership_status))))))
public.recordings  [Members delete their recordings]  DELETE  to authenticated
    using: (( SELECT private.is_executive() AS is_executive) OR (uploaded_by = ( SELECT auth.uid() AS uid)))
    check: -
public.recordings  [Members edit their recordings]  UPDATE  to authenticated
    using: (( SELECT private.is_executive() AS is_executive) OR (uploaded_by = ( SELECT auth.uid() AS uid)))
    check: (( SELECT private.is_executive() AS is_executive) OR ((uploaded_by = ( SELECT auth.uid() AS uid)) AND (subgroup_id IS NOT NULL) AND (EXISTS ( SELECT 1 FROM subgroup_memberships membership WHERE ((membership.subgroup_id = recordings.subgroup_id) AND (membership.member_id = ( SELECT auth.uid() AS uid)) AND (membership.status = 'active'::subgroup_membership_status))))))
public.recordings  [Members view accessible recordings]  SELECT  to authenticated
    using: (( SELECT private.is_executive() AS is_executive) OR (uploaded_by = ( SELECT auth.uid() AS uid)) OR ((status = 'published'::recording_status) AND ((audience = 'club'::text) OR (audience = 'public'::text) OR ((audience = 'subgroup'::text) AND (subgroup_id IS NOT NULL) AND (EXISTS ( SELECT 1 FROM subgroup_memberships membership WHERE ((membership.subgroup_id = recordings.subgroup_id) AND (membership.member_id = ( SELECT auth.uid() AS uid)) AND (membership.status = 'active'::subgroup_membership_status))))))))
    check: -
