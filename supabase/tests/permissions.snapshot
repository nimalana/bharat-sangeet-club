# table grants
admin_audit_log  authenticated  SELECT
announcements  authenticated  DELETE,INSERT,SELECT,UPDATE
archive_items  anon  SELECT
archive_items  authenticated  DELETE,INSERT,SELECT,UPDATE
attendance_eligibility  authenticated  INSERT,SELECT,UPDATE
attendance_excuses  authenticated  SELECT
attendance_record_audit  authenticated  SELECT
attendance_records  authenticated  SELECT
attendance_remediations  authenticated  SELECT
attendance_session_participants  authenticated  SELECT
attendance_sessions  authenticated  SELECT
attendance_settings  authenticated  SELECT
events  authenticated  DELETE,INSERT,SELECT,UPDATE
finance_audit_log  authenticated  SELECT
finance_claim_documents  authenticated  INSERT,SELECT
finance_documents  authenticated  INSERT,SELECT
finance_expense_documents  authenticated  INSERT,SELECT
finance_expenses  authenticated  SELECT
finance_payments  authenticated  SELECT
finance_reimbursement_documents  authenticated  INSERT,SELECT
funding_claim_expenses  authenticated  SELECT
funding_claims  authenticated  SELECT
member_deactivations  authenticated  SELECT
personal_reimbursements  authenticated  SELECT
profiles  authenticated  SELECT
recording_notes  authenticated  DELETE,INSERT,SELECT,UPDATE
recordings  authenticated  DELETE,INSERT,SELECT,UPDATE
resource_imports  authenticated  INSERT,SELECT,UPDATE
resource_links  authenticated  SELECT
resource_tag_assignments  authenticated  SELECT
resource_tags  authenticated  SELECT
resources  authenticated  DELETE,INSERT,SELECT,UPDATE
subgroup_memberships  authenticated  SELECT
subgroups  authenticated  SELECT
transactions  authenticated  SELECT
# column grants (column-level privileges; the table grants above do not show them)
public.profiles  authenticated  UPDATE (class_year, full_name, phone, specialty)
# sequence grants
# default privileges that give new objects to anon or authenticated (r = table, S = sequence, f = function)
for postgres in public  f  anon  EXECUTE
for postgres in public  f  authenticated  EXECUTE
# tables without row level security
# policies
public.admin_audit_log  [Active members only]  ALL  RESTRICTIVE  to authenticated
    using: ( SELECT private.is_active_member() AS is_active_member)
    check: ( SELECT private.is_active_member() AS is_active_member)
public.admin_audit_log  [Admins view audit log]  SELECT  to authenticated
    using: ( SELECT private.is_admin() AS is_admin)
    check: -
public.announcements  [Active members only]  ALL  RESTRICTIVE  to authenticated
    using: ( SELECT private.is_active_member() AS is_active_member)
    check: ( SELECT private.is_active_member() AS is_active_member)
public.announcements  [Executives delete announcements]  DELETE  to authenticated
    using: ( SELECT private.is_executive() AS is_executive)
    check: -
public.announcements  [Executives insert announcements]  INSERT  to authenticated
    using: -
    check: (( SELECT private.is_executive() AS is_executive) AND (created_by = ( SELECT auth.uid() AS uid)))
public.announcements  [Executives update announcements]  UPDATE  to authenticated
    using: ( SELECT private.is_executive() AS is_executive)
    check: ( SELECT private.is_executive() AS is_executive)
public.announcements  [Members view accessible announcements]  SELECT  to authenticated
    using: (( SELECT private.is_executive() AS is_executive) OR (subgroup_id IS NULL) OR (EXISTS ( SELECT 1 FROM subgroup_memberships membership WHERE ((membership.subgroup_id = announcements.subgroup_id) AND (membership.member_id = ( SELECT auth.uid() AS uid)) AND (membership.status = 'active'::subgroup_membership_status)))))
    check: -
