public.recording_notes  [Members add notation to accessible recordings]  INSERT  to authenticated
    using: -
    check: ((uploaded_by = ( SELECT auth.uid() AS uid)) AND (EXISTS ( SELECT 1 FROM recordings recording WHERE ((recording.id = recording_notes.recording_id) AND (( SELECT private.is_executive() AS is_executive) OR (recording.uploaded_by = ( SELECT auth.uid() AS uid)) OR (recording.status = 'published'::recording_status))))))
public.recording_notes  [Members delete their notation]  DELETE  to authenticated
    using: (( SELECT private.is_executive() AS is_executive) OR (uploaded_by = ( SELECT auth.uid() AS uid)) OR (EXISTS ( SELECT 1 FROM recordings recording WHERE ((recording.id = recording_notes.recording_id) AND (recording.uploaded_by = ( SELECT auth.uid() AS uid))))))
    check: -
